# =====================================================================================================
# Configuration d'ALERTE — modèle COMPLET. Copiez ce fichier en backend/.env (jamais commité) :
#     cp -n .env.example backend/.env        (Windows PowerShell : Copy-Item -NoClobber .env.example backend\.env)
# `python scripts/setup.py` le fait pour vous. Le MÊME code tourne partout (Linux, Windows, AWS) : seule cette
# configuration change. Les variables sont lues par le backend DEPUIS LE DOSSIER OÙ IL EST LANCÉ (backend/) ;
# une variable déjà définie dans l'environnement du shell PRIME sur ce fichier.
# Chaque variable : à quoi elle sert · OBLIGATOIRE ou FACULTATIVE · valeur d'exemple sûre · ce qui en dépend.
# AUCUN secret réel ici : les clés ne vont que dans backend/.env, protégé par .gitignore.
# Vérifier la configuration avant de démarrer : python scripts/doctor.py   (voir docs/runbooks/configuration-env.md)
# =====================================================================================================

# ---- 1. Données ------------------------------------------------------------------------------------
# Racine des données (base SQLite, blobs, index vectoriel, ancres, exports). FACULTATIVE (défaut ./data, relatif au dossier de lancement).
# Un ALERTE_DATA_DIR vide = un espace neuf (rien n'est supprimé dans l'ancien). Préférez un chemin ABSOLU hors du dépôt.
ALERTE_DATA_DIR=./data
# URL SQLAlchemy de la base. FACULTATIVE (défaut : SQLite dans ALERTE_DATA_DIR/db). L'architecture V1 est SQLite, un seul écrivain :
# ne pas changer sans raison (voir docs/architecture).
# ALERTE_DB_URL=
# Taille maximale d'un fichier importé, en Mo. FACULTATIVE (défaut 100).
# ALERTE_UPLOAD_MAX_MB=100

# ---- 2. Serveur de modèles de GÉNÉRATION (agents) --------------------------------------------------
# Peut tourner sur une AUTRE machine (Ollama, vLLM, toute API compatible OpenAI). Le nom du modèle doit être EXACTEMENT celui servi :
#   Ollama : `ollama list` (forme « qwen2.5:14b-instruct », avec « : »)   ·   vLLM : le nom passé à --served-model-name (forme « Qwen/... »)
# Mode : openai_compat = vrai modèle · scripted = règles déterministes SANS IA (tests) · cassette = rejeu. FACULTATIVE (défaut openai_compat).
ALERTE_LLM_MODE=openai_compat
# URL de base se terminant par /v1. OBLIGATOIRE pour un exercice « Modèle réel ». Test : curl <URL>/models
# ALERTE_LLM_BASE_URL=http://localhost:11434/v1
# Nom exact du modèle servi. OBLIGATOIRE pour un exercice « Modèle réel ». Si le nom est faux, la préparation de l'exercice est BLOQUÉE.
# ALERTE_LLM_MODEL=qwen2.5:1.5b-instruct
# Clé d'API du serveur (vLLM lancé avec --api-key). FACULTATIVE (Ollama n'en exige pas).
# ALERTE_LLM_API_KEY=
# Délai maximal d'un appel au modèle, en secondes. FACULTATIVE (défaut 120). À augmenter pour un gros modèle sur CPU.
# ALERTE_LLM_TIMEOUT_S=120
# Plafond d'appels au modèle par exercice quand l'exercice n'en fixe pas lui-même (réglage « Budget d'appels » de l'exercice, qui PRIME).
# FACULTATIVE (défaut 199, critère T6 « moins de 200 appels »). Un exercice Rising Waters complet demande davantage : fixez le budget
# dans le formulaire de l'exercice (voir le guide), pas ici.
ALERTE_MAX_LLM_CALLS=199
# Préréglages de machines d'inférence pour `python scripts/llm_target.py` (bascule sans toucher au code) : ALERTE_LLM_<NOM>_BASE_URL / _MODEL / _API_KEY.
# Ils sont écrits par le script lui-même ; ne les saisissez à la main que si vous savez pourquoi.

# ---- 3. Serveur d'EMBEDDINGS (recherche hybride) ---------------------------------------------------
# Indépendant du serveur de génération (peut être une autre machine). OBLIGATOIRES pour construire une base avec vecteurs et pour la
# recherche hybride ; sans eux la recherche est lexicale seule et la publication d'une base est REFUSÉE (vecteurs incomplets).
# ALERTE_EMBED_BASE_URL=http://localhost:11434/v1
# ALERTE_EMBED_MODEL=bge-m3
# Fournisseur : openai_compat (réel) | fixture (tests uniquement, vecteurs factices : jamais pour une vraie base). FACULTATIVE.
ALERTE_EMBED_PROVIDER=openai_compat
# ALERTE_EMBED_API_KEY=
# Extraits envoyés par requête. FACULTATIVE (défaut 16). Mettre 1 à 4 sur une machine lente ou saturée (CPU seul).
# ALERTE_EMBED_BATCH_SIZE=16
# Délai maximal d'une requête d'embeddings, en secondes. FACULTATIVE (défaut 60). Sur CPU seul avec de longs extraits : 300.
# ALERTE_EMBED_TIMEOUT_S=60
# Empreinte de l'embedder (versionnement des index). FACULTATIVES : modifier l'une d'elles change l'empreinte ⇒ revectorisation complète.
# ALERTE_EMBED_REVISION=
# ALERTE_EMBED_RUNTIME=
# ALERTE_EMBED_QUANTIZATION=
# Poids d'autorité dans le classement des résultats : 0 = neutre (défaut, d'après l'évaluation), 1 = poids de search.py. FACULTATIVE.
# ALERTE_AUTHORITY_SPREAD=0

# ---- 4. OCR (PDF scannés) --------------------------------------------------------------------------
# Tesseract doit être installé (Linux : apt install tesseract-ocr ; Windows : installeur UB Mannheim ; macOS : brew install tesseract).
# Dossier `tessdata` contenant ara.traineddata, fra.traineddata, eng.traineddata. FACULTATIVE si Tesseract du système a ces langues.
# Utilisez un chemin ABSOLU (un chemin relatif dépend du dossier de lancement). Test : tesseract --list-langs --tessdata-dir <chemin>
# ALERTE_TESSDATA_DIR=/home/vous/alerte-platform/backend/data-kb-build/tessdata
# Langues OCR demandées, séparées par « + ». FACULTATIVE (défaut ara+fra+eng ; retirez ara si le corpus n'en a pas besoin).
ALERTE_OCR_LANGS=ara+fra+eng

# ---- 5. Exécution ----------------------------------------------------------------------------------
# Exercices simultanés / tâches de fond (ingestion, embeddings). FACULTATIVES (défauts 2 et 2).
# ALERTE_MAX_CONCURRENT_EXERCISES=2
# ALERTE_JOB_WORKERS=2
# Niveau de journalisation et format JSON. FACULTATIVES (INFO, true). `ALERTE_LOG_JSON=false` pour un texte lisible en développement.
ALERTE_LOG_LEVEL=INFO
# ALERTE_LOG_JSON=true

# ---- 6. Web / sécurité -----------------------------------------------------------------------------
# Origines autorisées (CORS), séparées par des virgules. FACULTATIVE (défaut http://localhost:5173).
ALERTE_CORS_ORIGINS=http://localhost:5173
# Création d'espace libre au premier démarrage seulement. FACULTATIVE (défaut false) ; true uniquement le temps d'un amorçage.
ALERTE_BOOTSTRAP_ENABLED=false
# Clé Ed25519 de signature des ancres du journal. FACULTATIVE (générée dans ALERTE_DATA_DIR si absente).
# ALERTE_SIGNING_KEY_PATH=

# ---- 7. Frontend (variables lues par Vite, pas par le backend) -------------------------------------
# Adresse du backend vers laquelle le serveur de développement Vite redirige /api. FACULTATIVE (défaut http://localhost:8000).
# À définir dans l'ENVIRONNEMENT du shell avant `npm run dev`, pas dans backend/.env :  ALERTE_API_URL=http://localhost:8000
# VITE_API_BASE (chemin de l'API vu par le navigateur, défaut /api/v1) : ne changer qu'avec un reverse proxy.

# ---- 8. Outils et scripts (hors application) -------------------------------------------------------
# ALERTE_ENV_FILE        fichier .env que lit/écrit scripts/llm_target.py (défaut backend/.env)
# ALERTE_LEGACY_DIR      dossier `alerte/` du prototype, lu SEULEMENT par rising_waters_pack.py pour les scénarios (jamais pour les connaissances)
# ALERTE_TOKEN           jeton d'API pour les scripts de démonstration (backend/scripts/ledger_tamper_demo.py) : à passer par l'environnement, jamais en argument
