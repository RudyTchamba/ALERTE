# Configuration d'ALERTE (variables d'environnement ALERTE_*). Copiez ce fichier en backend/.env (jamais commité).
# Le MÊME code tourne partout : seule cette configuration change entre un poste de dev, une machine d'équipe et le Sandbox.

# --- Données (DB SQLite, blobs, index vectoriel, ancres, exports) ------------------------------
ALERTE_DATA_DIR=./data
# ALERTE_UPLOAD_MAX_MB=100

# --- Serveur de modèles de GÉNÉRATION (n'importe quelle machine : Ollama, vLLM, API compatible OpenAI) ---
ALERTE_LLM_MODE=openai_compat          # openai_compat | scripted | cassette (les deux derniers : tests/rejeu, étiquetés « SANS IA »)
# ALERTE_LLM_BASE_URL=http://machine-equipe:8000/v1
# ALERTE_LLM_MODEL=qwen2.5-14b-instruct
# ALERTE_LLM_API_KEY=
ALERTE_MAX_LLM_CALLS=199               # budget par exercice (T6 : < 200)

# --- Serveur d'EMBEDDINGS (indépendant du précédent ; requis pour la recherche hybride) --------------
# ALERTE_EMBED_BASE_URL=http://machine-equipe:8080/v1
# ALERTE_EMBED_MODEL=bge-m3
ALERTE_EMBED_PROVIDER=openai_compat    # openai_compat | fixture (tests uniquement)

# --- OCR (Tesseract doit être installé ; langues ara+fra+eng) ----------------------------------------
# ALERTE_TESSDATA_DIR=/chemin/vers/tessdata
ALERTE_OCR_LANGS=ara+fra+eng

# --- Web / sécurité ---------------------------------------------------------------------------------------
ALERTE_CORS_ORIGINS=http://localhost:5173
ALERTE_BOOTSTRAP_ENABLED=false         # POST /workspaces libre au premier démarrage uniquement
ALERTE_LOG_LEVEL=INFO
