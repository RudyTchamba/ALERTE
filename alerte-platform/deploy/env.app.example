# Variables de la machine APPLICATIVE (Docker). Copier en deploy/.env.app (ignoré par git). Aucun secret réel ici.
# Référence complète de toutes les variables : ../.env.example et docs/runbooks/configuration-env.md
ALERTE_LLM_MODE=openai_compat
ALERTE_LLM_BASE_URL=http://host.docker.internal:11434/v1
ALERTE_LLM_MODEL=qwen2.5:1.5b-instruct
# ALERTE_LLM_API_KEY=
ALERTE_EMBED_PROVIDER=openai_compat
ALERTE_EMBED_BASE_URL=http://host.docker.internal:11434/v1
ALERTE_EMBED_MODEL=bge-m3
ALERTE_CORS_ORIGINS=http://localhost:8000
ALERTE_BOOTSTRAP_ENABLED=false
ALERTE_OCR_LANGS=ara+fra+eng
ALERTE_LOG_LEVEL=INFO
# Port publié sur l'hôte (défaut 8000)
# ALERTE_PORT=8000
