{
  "name": "alerte-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint src",
    "typecheck": "tsc -p tsconfig.app.json --noEmit",
    "gen:api": "openapi-typescript http://localhost:8000/api/v1/openapi.json --default-non-nullable false -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@hookform/resolvers": "^7.0.8",
    "@tanstack/react-query": "^5.108.2",
    "clsx": "^2.1.1",
    "i18next": "^27.2.2",
    "lucide-react": "^1.77.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.92.0",
    "react-i18next": "^18.0.3",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^8.0.0",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.13",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "axe-core": "^4.14.1",
    "jsdom": "^31.0.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.90.0",
    "tailwindcss": "^4.3.5",
    "typescript": "~5.9",
    "vite": "^8.3.6",
    "vitest": "^5.1.1"
  },
  "engines": {
    "node": ">=22"
  }
}
