# Copy this file to .env and change what you need. Every line is optional.

# ---- Brain: what plays the institutions -------------------------------------
# offline = rule-based, no AI model needed, always works (default)
# llm     = an AI model through any OpenAI-compatible endpoint
# offline = rule engine, NO AI (fast, reproducible). llm = an AI model writes each institution's words (needs a model: docs/AGENTS.md)
ALERTE_BRAIN=offline

# Ollama on your computer (free): install from https://ollama.com, then
#   ollama pull qwen2.5:7b-instruct
ALERTE_LLM_BASE_URL=http://localhost:11434/v1
ALERTE_LLM_MODEL=qwen2.5:7b-instruct
ALERTE_LLM_API_KEY=ollama
# In the ITU sandbox / a GPU server running vLLM, for example:
#   ALERTE_LLM_BASE_URL=http://<sandbox-host>:8000/v1
#   ALERTE_LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
ALERTE_LLM_TIMEOUT=180
ALERTE_LLM_TEMPERATURE=0.2
ALERTE_LLM_MAX_TOKENS=900

# ---- Embeddings: meaning-based search (optional) ----------------------------
# none = keyword search only (default, works everywhere)
# ollama: run `ollama pull bge-m3` (multilingual: French, English, Arabic)
# fastembed: CPU only, no server (pip install fastembed)
ALERTE_EMBED=none
ALERTE_EMBED_MODEL=bge-m3
ALERTE_EMBED_BASE_URL=http://localhost:11434

# ---- Drill -------------------------------------------------------------------
ALERTE_LANG=en
ALERTE_MAX_ROUNDS=2
ALERTE_TOP_K=5

# ---- Folders (defaults are inside this project) -----------------------------
# ALERTE_INDEX_DIR=index
# ALERTE_RUNS_DIR=runs
# Path to the ITU reference repository, if ALERTE is not inside your fork of it
# ALERTE_ITU_ROOT=../ITUAIReadiness

# ---- Slack: post drill summaries to a team channel (optional) ---------------
# Create an Incoming Webhook (https://api.slack.com/messaging/webhooks) and paste it here.
ALERTE_SLACK_WEBHOOK_URL=

# --- Reading documents (OCR) ---------------------------------------------------------------
# Every file under data/docs/ (any subfolder) and under these extra folders is added to the knowledge base.
# Separate several folders with ;   Example: ALERTE_EXTRA_DOC_DIRS=D:\Scans;D:\Laws
ALERTE_EXTRA_DOC_DIRS=
# Tesseract program and language models (normally found automatically; ocr/tessdata is checked first)
# ALERTE_TESSERACT=C:\Program Files\Tesseract-OCR\tesseract.exe
# ALERTE_TESSDATA=
# 1 = run every OCR pass on every page (slowest, most careful). Default: extra passes only when a page is uncertain.
ALERTE_OCR_THOROUGH=0
ALERTE_OCR_DPI=300
ALERTE_OCR_WORKERS=2
# Pages below this OCR confidence (0-100) or where two passes agree less than the second value are flagged for proofreading
ALERTE_OCR_CONF_OK=88
ALERTE_OCR_AGREE_OK=0.97


# Cap on AI model calls per drill (decisions first, the agents' discussion uses what is left)
ALERTE_LLM_BUDGET=150
